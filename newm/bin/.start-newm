#!/usr/bin/env python3
import subprocess
import sys
import os
import argparse

def is_command_available(cmd):
    try:
        subprocess.run([cmd, "--help"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        return True
    except FileNotFoundError:
        return False

try:
    from newm import run
except ImportError:
    print("Модуль 'newm' не найден в site-packages.")
    if not is_command_available("sqwm-linker"):
        print("❌ Команда 'sqwm-linker' не найдена.")
        sys.exit(1)

    import site
    site_packages_paths = site.getsitepackages()
    for path in site_packages_paths:
        result = subprocess.run(
            ["sqwm-linker", path],
            capture_output=True,
            text=True,
        )
        if result.returncode == 0:
            try:
                from newm import run
                break
            except ImportError:
                continue
        else:
            print(f"❌ Ошибка (код {result.returncode}):", result.stderr)
            sys.exit(1)
    else:
        print("❌ Модуль 'newm' не удалось установить или найти.")
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(
        description='newm-qs Wayland compositor',
        epilog='Example: .start-newm --debug --config ~/.config/newm/config.py'
    )
    parser.add_argument('-d', '--debug', action='store_true', help='enable debug mode')
    parser.add_argument('-p', '--profile', action='store_true', help='enable profiling')
    parser.add_argument('-c', '--config', type=str, help='path to config file')

    try:
        args, unknown = parser.parse_known_args()
    except argparse.ArgumentError as e:
        print(f"Argument error: {e}", file=sys.stderr)
        sys.exit(1)

    if args.config and not os.path.isfile(args.config):
        print(f"Error: Config file not found: {args.config}", file=sys.stderr)
        sys.exit(1)

    print("newm-next: hello there!")
    print(f"newm-next: version 0.4.4")
    print(f"newm-next: received arguments: {sys.argv[1:]}")

    if unknown:
        print(f"Warning: Ignoring unknown arguments: {unknown}", file=sys.stderr)

    try:
        run(debug=args.debug,
            profile=args.profile,
            config_file=args.config)
    except KeyboardInterrupt:
        print("\nnewm-next: завершение работы...")
        sys.exit(0)
    except Exception as e:
        print(f"Fatal error: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
