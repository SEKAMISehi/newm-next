import subprocess
import sys
import os
import argparse
import site
from shutil import which

class LinkerUI:
    @staticmethod
    def print_success(message: str):
        print(f"✓ {message}")

    @staticmethod
    def print_error(message: str):
        print(f"❌ {message}", file=sys.stderr)

def is_command_available(cmd: str) -> bool:
    return which(cmd) is not None

def run_linker() -> bool:
    linker_path = which("sqwm-linker")
    if not linker_path:
        LinkerUI.print_error("Команда 'sqwm-linker' не найдена в PATH")
        LinkerUI.print_error(f"Текущий PATH: {os.getenv('PATH')}")
        return False

    if not os.access(linker_path, os.X_OK):
        LinkerUI.print_error(f"Нет прав на выполнение скрипта: {linker_path}")
        return False

    success = True
    for path in site.getsitepackages():
        print(f"\nЗапуск линкера для: {path}")
        process = subprocess.Popen(
            ["bash", linker_path, path],
            stdout=sys.stdout,
            stderr=sys.stderr,
            text=True
        )

        return_code = process.wait()
        if return_code != 0:
            LinkerUI.print_error(f"Ошибка (код {return_code}) при связывании {path}")
            success = False
            break
        else:
            LinkerUI.print_success(f"Успешно завершено для {path}")

    return success

def import_newm() -> bool:
    try:
        __import__("newm")
        return True
    except ImportError:
        return False

def main():
    parser = argparse.ArgumentParser(description='newm-qs Wayland compositor')
    parser.add_argument('-d', '--debug', action='store_true', help='enable debug mode')
    parser.add_argument('-p', '--profile', action='store_true', help='enable profiling')
    parser.add_argument('-c', '--config', type=str, help='path to config file')
    parser.add_argument('-l', '--linker', action='store_true', help='run modules linker before starting')

    args = parser.parse_args()

    if args.linker or not import_newm():
        print("\nПодготовка линкера модулей...")
        if not run_linker():
            LinkerUI.print_error("Линкер завершился с ошибками")
            sys.exit(1)

        if not import_newm():
            LinkerUI.print_error("Модуль 'newm' недоступен после линковки")
            sys.exit(1)

    try:
        from newm import run
    except ImportError as e:
        LinkerUI.print_error(f"Не удалось импортировать newm: {str(e)}")
        sys.exit(1)

    if args.config and not os.path.isfile(args.config):
        LinkerUI.print_error(f"Config file not found: {args.config}")
        sys.exit(1)

    print("\nnewm-qs: запуск...")
    try:
        run(debug=args.debug, profile=args.profile, config_file=args.config)
    except KeyboardInterrupt:
        print("\nЗавершение работы...")
        sys.exit(0)
    except Exception as e:
        LinkerUI.print_error(f"Ошибка: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()
