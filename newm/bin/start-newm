#!/usr/bin/bash
set -euo pipefail

SOURCE=${BASH_SOURCE[0]}
while [ -h "$SOURCE" ]; do
  DIR=$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)
  SOURCE=$(readlink "$SOURCE")
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR=$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)

# Configure logging
LOGDIR="${HOME}/.cache/newm"
if ! mkdir -p "$LOGDIR"; then
    LOGDIR="/tmp/newm"
    mkdir -p "$LOGDIR" || { echo "Cannot create log directory" >&2; exit 1; }
fi

# Rotate old log
if [ -e "$LOGDIR/newm_log" ]; then
    format=$(date -d "@$(stat -c %Y "$LOGDIR/newm_log" 2>/dev/null)" +"%Y-%m-%d-%s" 2>/dev/null || date +"%Y-%m-%d-%s")
    mv -f "$LOGDIR/newm_log" "$LOGDIR/newm_log.old.$format" || true
fi

# Process arguments
linker_flag=""
args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -l|--linker)
            linker_flag="--linker"
            shift
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

export XDG_SESSION_DESKTOP="newm-qs"

echo "newm-qs version 0.4.4"
echo "script dir is $DIR"
echo "log dir is $LOGDIR"
if [ ${#args[@]} -eq 0 ]; then
    echo "no arguments provided"
else
    echo "arguments are: ${args[*]}"
fi

# Verify executables exist
for cmd in "$DIR/start-newm-sockets" "$DIR/.start-newm"; do
    if [ ! -x "$cmd" ]; then
        echo "Error: $cmd not found or not executable" >&2
        exit 1
    fi
done

# Start services
if ! "$DIR/start-newm-sockets"; then
    echo "Failed to start sockets" >&2
    exit 1
fi

# Add linker flag if specified
if [ -n "$linker_flag" ]; then
    args+=("$linker_flag")
fi

exec -a newm python3 "$DIR/.start-newm" "${args[@]}" >"$LOGDIR/newm_log" 2>&1
